# EdgeTTS EdgeOne Pages 环境变量配置示例
# 复制此文件为 .env 并在 EdgeOne Pages 控制台中配置

# ======================
# API 安全配置
# ======================

# API 访问密钥 (建议设置强密码)
API_KEY=hello

# ======================
# 微软服务配置
# ======================

# 微软签名密钥 (可选，不设置将使用内置的默认密钥)
# 建议从微软官方获取最新的签名密钥以提升稳定性
# MS_SIGNING_KEY=your_microsoft_signing_key_here

# ======================
# 性能和限制配置
# ======================

# 最大并发请求数 (默认: 10)
# MAX_CONCURRENCY=10

# 默认文本分块大小 (默认: 300)
# DEFAULT_CHUNK_SIZE=300

# 最大文本长度限制 (默认: 120000)
# MAX_TEXT_LENGTH=120000

# 请求超时时间(毫秒) (默认: 30000)
# REQUEST_TIMEOUT=30000

# ======================
# 缓存配置
# ======================

# Token 缓存时间(秒) (默认: 3600)
# TOKEN_CACHE_TTL=3600

# Token 刷新提前时间(秒) (默认: 300)
# TOKEN_REFRESH_BEFORE_EXPIRY=300

# ======================
# 日志和监控配置
# ======================

# 日志级别 (debug, info, warn, error) (默认: info)
# LOG_LEVEL=info

# 是否启用详细日志 (true/false) (默认: false)
# ENABLE_VERBOSE_LOGGING=false

# 是否启用性能监控 (true/false) (默认: true)
# ENABLE_PERFORMANCE_MONITORING=true

# ======================
# 功能开关
# ======================

# 是否启用音频缓存 (true/false) (默认: false)
# ENABLE_AUDIO_CACHE=false

# 是否启用请求限流 (true/false) (默认: false)
# ENABLE_RATE_LIMITING=false

# 是否启用统计信息收集 (true/false) (默认: false)
# ENABLE_STATISTICS=false

# ======================
# 文本处理配置
# ======================

# 默认语言检测 (zh-CN, en-US, auto) (默认: auto)
# DEFAULT_LANGUAGE=auto

# 是否启用智能文本清理 (true/false) (默认: true)
# ENABLE_SMART_TEXT_CLEANING=true

# ======================
# EdgeOne Pages 特定配置
# ======================

# 是否在开发环境中启用调试模式 (true/false) (默认: false)
# DEBUG_MODE=false

# 自定义域名 (用于CORS配置等)
# CUSTOM_DOMAIN=your-custom-domain.com